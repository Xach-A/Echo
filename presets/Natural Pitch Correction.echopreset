{
  "category": "Pitch correction",
  "chain": [
    {
      "bypass": false,
      "params": {
        "hp_freq": 80,
        "hp_on": 1
      },
      "type": "filter"
    },
    {
      "bypass": false,
      "params": {
        "range": 1,
        "scale": 0,
        "style": 0
      },
      "type": "autotune"
    },
    {
      "bypass": false,
      "params": {
        "makeup": 3,
        "ratio": 2.5,
        "threshold": -20
      },
      "type": "compressor"
    },
    {
      "bypass": false,
      "params": {
        "ceiling": -1.0
      },
      "type": "limiter"
    }
  ],
  "description": "Gentle, slow correction toward the nearest semitone (chromatic). Set the key/scale for best results.",
  "format": "echo.chain-preset",
  "name": "Natural Pitch Correction",
  "version": 1
}