{
  "category": "Voice changer",
  "chain": [
    {
      "bypass": false,
      "params": {
        "preserve": 0,
        "semitones": -12
      },
      "type": "pitch"
    },
    {
      "bypass": false,
      "params": {
        "decay": 2.0,
        "mix": 18
      },
      "type": "reverb"
    },
    {
      "bypass": false,
      "params": {
        "ceiling": -1.0
      },
      "type": "limiter"
    }
  ],
  "description": "Huge, slow voice: pitch and formants far down together.",
  "format": "echo.chain-preset",
  "name": "Giant",
  "version": 1
}