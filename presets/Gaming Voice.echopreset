{
  "category": "Voice processing",
  "chain": [
    {
      "bypass": false,
      "params": {
        "vad_gate": 1,
        "vad_range": -45
      },
      "type": "voice_denoise"
    },
    {
      "bypass": false,
      "params": {
        "hp_freq": 120,
        "hp_on": 1,
        "hp_slope": 2
      },
      "type": "filter"
    },
    {
      "bypass": false,
      "params": {
        "b4_freq": 2500,
        "b4_gain": 3
      },
      "type": "eq"
    },
    {
      "bypass": false,
      "params": {
        "makeup": 6,
        "ratio": 4,
        "threshold": -20
      },
      "type": "compressor"
    },
    {
      "bypass": false,
      "params": {
        "ceiling": -1.0
      },
      "type": "limiter"
    }
  ],
  "description": "Aggressive noise rejection and a cutting mid boost so you are heard over game audio.",
  "format": "echo.chain-preset",
  "name": "Gaming Voice",
  "version": 1
}