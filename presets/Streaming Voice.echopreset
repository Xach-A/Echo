{
  "category": "Voice processing",
  "chain": [
    {
      "bypass": false,
      "params": {},
      "type": "voice_denoise"
    },
    {
      "bypass": false,
      "params": {
        "hp_freq": 90,
        "hp_on": 1,
        "hp_slope": 1
      },
      "type": "filter"
    },
    {
      "bypass": false,
      "params": {
        "range": -40,
        "threshold": -50
      },
      "type": "gate"
    },
    {
      "bypass": false,
      "params": {
        "b2_freq": 250,
        "b2_gain": -2.5,
        "b4_freq": 3200,
        "b4_gain": 3,
        "b6_freq": 10000,
        "b6_gain": 2
      },
      "type": "eq"
    },
    {
      "bypass": false,
      "params": {
        "attack": 5,
        "makeup": 5,
        "ratio": 3.5,
        "release": 120,
        "threshold": -22
      },
      "type": "compressor"
    },
    {
      "bypass": false,
      "params": {
        "freq": 6500,
        "reduction": 8,
        "threshold": -32
      },
      "type": "deesser"
    },
    {
      "bypass": false,
      "params": {
        "ceiling": -1.0
      },
      "type": "limiter"
    }
  ],
  "description": "Present, compressed broadcast voice for streams: noise suppression, EQ, compression, de-essing.",
  "format": "echo.chain-preset",
  "name": "Streaming Voice",
  "version": 1
}