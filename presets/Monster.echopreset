{
  "category": "Voice changer",
  "chain": [
    {
      "bypass": false,
      "params": {
        "formant": -5,
        "preserve": 1,
        "semitones": -9
      },
      "type": "pitch"
    },
    {
      "bypass": false,
      "params": {
        "drive": 14,
        "mix": 40,
        "output": -6,
        "type": 2
      },
      "type": "distortion"
    },
    {
      "bypass": false,
      "params": {
        "b1_freq": 100,
        "b1_gain": 4
      },
      "type": "eq"
    },
    {
      "bypass": false,
      "params": {
        "decay": 1.3,
        "mix": 15
      },
      "type": "reverb"
    },
    {
      "bypass": false,
      "params": {
        "ceiling": -1.0
      },
      "type": "limiter"
    }
  ],
  "description": "Growling creature: much lower pitch and formants, grit and space.",
  "format": "echo.chain-preset",
  "name": "Monster",
  "version": 1
}