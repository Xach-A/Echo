{
  "category": "Voice processing",
  "chain": [
    {
      "bypass": false,
      "params": {
        "vad_gate": 1,
        "vad_hold": 350,
        "vad_range": -40
      },
      "type": "voice_denoise"
    },
    {
      "bypass": false,
      "params": {
        "hp_freq": 90,
        "hp_on": 1,
        "hp_slope": 1
      },
      "type": "filter"
    },
    {
      "bypass": false,
      "params": {
        "makeup": 4,
        "ratio": 3,
        "threshold": -20
      },
      "type": "compressor"
    },
    {
      "bypass": false,
      "params": {
        "ceiling": -1.0
      },
      "type": "limiter"
    }
  ],
  "description": "Maximum noise removal for loud rooms: neural noise suppression with the voice-activity gate (silence between sentences), plus compression.",
  "format": "echo.chain-preset",
  "name": "Noise-Reduced Microphone",
  "version": 1
}