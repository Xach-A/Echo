{
  "category": "Pitch correction",
  "chain": [
    {
      "bypass": false,
      "params": {
        "hp_freq": 90,
        "hp_on": 1
      },
      "type": "filter"
    },
    {
      "bypass": false,
      "params": {
        "range": 1,
        "scale": 0,
        "style": 1
      },
      "type": "autotune"
    },
    {
      "bypass": false,
      "params": {
        "makeup": 5,
        "ratio": 4,
        "threshold": -22
      },
      "type": "compressor"
    },
    {
      "bypass": false,
      "params": {
        "decay": 1.4,
        "mix": 14
      },
      "type": "reverb"
    },
    {
      "bypass": false,
      "params": {
        "ceiling": -1.0
      },
      "type": "limiter"
    }
  ],
  "description": "Instant, robotic pitch snapping (the classic 'autotune' effect) with a touch of reverb.",
  "format": "echo.chain-preset",
  "name": "Hard Autotune",
  "version": 1
}