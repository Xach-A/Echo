{
  "category": "Voice changer",
  "chain": [
    {
      "bypass": false,
      "params": {
        "formant": -2.5,
        "preserve": 1,
        "semitones": -4
      },
      "type": "pitch"
    },
    {
      "bypass": false,
      "params": {
        "b1_freq": 130,
        "b1_gain": 2
      },
      "type": "eq"
    },
    {
      "bypass": false,
      "params": {
        "ceiling": -1.0
      },
      "type": "limiter"
    }
  ],
  "description": "Lowers pitch and formants moderately. Results depend strongly on the speaker; perceived gender also depends on resonance, intonation and speaking style.",
  "format": "echo.chain-preset",
  "name": "Masculine-style Voice",
  "version": 1
}