{
  "category": "Voice changer",
  "chain": [
    {
      "bypass": false,
      "params": {
        "formant": -2.5,
        "preserve": 1,
        "semitones": -5
      },
      "type": "pitch"
    },
    {
      "bypass": false,
      "params": {
        "b1_freq": 120,
        "b1_gain": 3
      },
      "type": "eq"
    },
    {
      "bypass": false,
      "params": {
        "makeup": 3,
        "ratio": 3,
        "threshold": -20
      },
      "type": "compressor"
    },
    {
      "bypass": false,
      "params": {
        "ceiling": -1.0
      },
      "type": "limiter"
    }
  ],
  "description": "Lower pitch and slightly larger vocal tract (formants down) for a deep voice.",
  "format": "echo.chain-preset",
  "name": "Deep Voice",
  "version": 1
}