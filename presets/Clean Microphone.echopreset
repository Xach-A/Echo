{
  "category": "Voice processing",
  "chain": [
    {
      "bypass": false,
      "params": {},
      "type": "voice_denoise"
    },
    {
      "bypass": false,
      "params": {
        "hp_freq": 80,
        "hp_on": 1,
        "hp_slope": 1
      },
      "type": "filter"
    },
    {
      "bypass": false,
      "params": {
        "range": -30,
        "release": 200,
        "threshold": -52
      },
      "type": "gate"
    },
    {
      "bypass": false,
      "params": {
        "attack": 10,
        "knee": 6,
        "makeup": 3,
        "ratio": 2.5,
        "release": 150,
        "threshold": -20
      },
      "type": "compressor"
    },
    {
      "bypass": false,
      "params": {
        "ceiling": -1.0
      },
      "type": "limiter"
    }
  ],
  "description": "Noise suppression, rumble filter, gentle gate and compression, safety limiter. A transparent starting point.",
  "format": "echo.chain-preset",
  "name": "Clean Microphone",
  "version": 1
}