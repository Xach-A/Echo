{
  "category": "Voice changer",
  "chain": [
    {
      "bypass": false,
      "params": {
        "mode": 1
      },
      "type": "robot"
    },
    {
      "bypass": false,
      "params": {
        "b5_freq": 5000,
        "b5_gain": 3
      },
