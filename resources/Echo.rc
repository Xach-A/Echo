#include <windows.h>
#include "Version.h"

1 ICON "echo.ico"

1 VERSIONINFO
FILEVERSION ECHO_VERSION_MAJOR, ECHO_VERSION_MINOR, ECHO_VERSION_PATCH, 0
PRODUCTVERSION ECHO_VERSION_MAJOR, ECHO_VERSION_MINOR, ECHO_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ECHO_APP_PUBLISHER
            VALUE "FileDescription", ECHO_APP_NAME " - virtual audio mixer and voice changer"
            VALUE "FileVersion", ECHO_VERSION_STRING
            VALUE "InternalName", ECHO_APP_NAME
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", ECHO_APP_NAME ".exe"
            VALUE "ProductName", ECHO_APP_NAME
            VALUE "ProductVersion", ECHO_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 RT_MANIFEST "Echo.manifest"
